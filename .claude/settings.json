{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm install)",
      "Bash(pnpm add *)",
      "Bash(npx jest *)",
      "Bash(npx eslint *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(pnpm publish *)",
      "Bash(git push *)",
      "Bash(git push)"
    ]
  }
}